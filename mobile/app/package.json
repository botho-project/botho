{
  "name": "botho-mobile",
  "version": "0.6.0",
  "description": "Botho Mobile Wallet",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm/)(?!((jest-)?react-native|@react-native(-community)?|@react-native/[^/]+|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|standard-navigation|zustand))"
    ]
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.16",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-local-authentication": "~57.0.2",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.8.1",
    "react-native-screens": "~4.27.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.0.0",
    "jest-expo": "~57.0.4",
    "typescript": "^6.0.3"
  },
  "private": true
}
