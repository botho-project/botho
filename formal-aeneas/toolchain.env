# Pinned Charon + Aeneas toolchain for formal-aeneas/ (#1712).
#
# Sourced by regen.sh and by .github/workflows/aeneas-extract.yml. Bumping any
# value here changes the generated Lean: re-run regen.sh and commit the result
# in the same change.
#
# The Aeneas release tarball bundles a matching `charon` / `charon-driver`
# (Charon 0.1.304, 7b462d9159db2ed3015162352183906a30bfafc6) and the Lean
# backend library (backends/lean, Lean v4.35.0 + Mathlib v4.35.0).

AENEAS_TAG=nightly-2026.11.02-ab34bd2
AENEAS_COMMIT=ab34bd28458a08c150b7cbf1873e59af74588138

# sha256 of the release assets at AENEAS_TAG.
AENEAS_SHA256_linux_x86_64=f8ea7c69036915c7330816b7f5a679efbe443b736e9058c03e91067c66ddade4
AENEAS_SHA256_linux_aarch64=34c6771a6bac6513df71a79adfbd8c1275c86802165da92547065c1af4cc962f
AENEAS_SHA256_macos_aarch64=1f6db91ae0ec8fe2174720b6b1a7a2dc9beda4f03c648a4765e7e0379294aa8f

# The Rust nightly charon-driver links against (from the tarball's
# rust-toolchain). Independent of the workspace rust-toolchain, which is not
# read or changed.
CHARON_RUST_NIGHTLY=nightly-2026-09-17
CHARON_RUST_COMPONENTS=rustc-dev,llvm-tools,rust-src,miri
