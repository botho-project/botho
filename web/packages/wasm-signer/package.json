{
  "name": "@botho/wasm-signer",
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side Botho transaction builder + CLSAG signer (WebAssembly). Keys never leave the browser.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pkg-bundler/*": "./pkg-bundler/*"
  },
  "files": [
    "src",
    "pkg",
    "pkg-bundler"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg --out-name bth_wasm_signer",
    "build:wasm:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler --out-name bth_wasm_signer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@botho/core": "workspace:*",
    "@scure/bip39": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
