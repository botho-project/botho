+#[cfg(test)]
+mod cleanup_tests {
+    use super::*;
+
+    #[test]
+    fn secrets_cleanup_overwrites_every_live_scalar() {
+        let secret = vec![Scalar::from(17u64), Scalar::from(29u64)];
+        let mut secrets = Secrets {
+            a_L: secret.clone(),
+            a_R: secret.clone(),
+            a_O: secret.clone(),
+            v: secret.clone(),
+            v_blinding: secret,
+        };
+        // Exercise the exact cleanup called by Drop before the allocations are freed.
+        // Keeping length two makes Vec::clear (which does not wipe storage) fail.
+        secrets.clear_secrets();
+        for values in [
+            &secrets.a_L,
+            &secrets.a_R,
+            &secrets.a_O,
+            &secrets.v,
+            &secrets.v_blinding,
+        ] {
+            assert_eq!(values.len(), 2);
+            for scalar in values {
+                assert_eq!(scalar.to_bytes(), [0u8; 32]);
+            }
+        }
+    }
+}
