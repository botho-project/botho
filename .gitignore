# Logs
logs
*.log
junit*

# Rust
# Generated by Cargo
# will have compiled files and executables
**/target/

# Reproducible release build scratch dirs (scripts/build-release.sh).
# These live at the repo root and would otherwise show as untracked, marking
# the working tree "dirty" and mislabeling tagged release binaries as
# "<hash>-dirty" (see botho/build.rs and #996).
/target-release/
/.cargo-home/

# Coverage reports
coverage-report/

# Playwright / e2e test artifacts
test-results/

# These are backup files generated by rustfmt
**/*.rs.bk

# These are backup files generated by emacs
*~

# Generated binary libraries
*.so
*.a

# Proptest regression files for when proptest's fail
**/proptest-regressions

# lmdb lock files
lock.mdb

# Random junk
.DS_Store
.vscode
*.swp

# Secrets — private keys, keystores, generated testnet accounts.
# NEVER commit key material. See scripts/bridge-testnet-accounts.sh (#1008).
.secrets/

# Dockerfile-build output
dist/

# Per-crate lock files
Cargo.lock
!/Cargo.lock
# The Solana program's lock IS committed: CI must keep it at lockfile
# version 3 so Solana 1.18.26's bundled cargo-build-sbf (Cargo <= v3)
# can parse it (#883 / PR #894).
!/contracts/solana/Cargo.lock

# Homebrew bundle
/Brewfile.lock.json

# Python stuff
__pycache__/
*.pyc

# build automation tmp
.tmp

.env
*.private
# Cloudflare wrangler local state at repo root (web/.gitignore covers only web/)
/.wrangler/
